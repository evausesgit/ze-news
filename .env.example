# Copier en .env pour le dev local (jamais commité). En prod : variables Coolify.

DATABASE_URL=postgresql+psycopg://lefil:changeme@127.0.0.1:5432/lefil
INTERNAL_API_TOKEN=

# Telegram (https://my.telegram.org → API development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Obtenue avec : uv run python -m scripts.telegram_login
# ⚠️ Accès COMPLET au compte Telegram : secret, machine privée uniquement.
TELEGRAM_SESSION=

# Codex CLI (chemin absolu si le PATH ne contient pas ~/.npm-global/bin)
CODEX_BIN=codex
CODEX_MODEL=gpt-5.6-luna
CODEX_REASONING=low
CODEX_WEB_SEARCH=true

POLL_INTERVAL_SECONDS=600
ENRICH_BATCH_SIZE=20
